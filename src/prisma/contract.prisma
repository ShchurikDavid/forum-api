// use prisma-8

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  author    String
  categoryId Int
  category Category @relation(fields: [categoryId], references: [id])
  @@index([categoryId])
}

model Category {
  id Int @id @default(autoincrement())
  name String @unique
  posts Post[]
}
